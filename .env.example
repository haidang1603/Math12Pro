# ==============================================================================
# MATH12PRO - SUPABASE & DATABASE CONFIGURATION (.env)
# ==============================================================================

# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL + PRISMA ORM)
# Lấy từ: Supabase Dashboard -> Project Settings -> Database -> Connection string

# [Khuyến nghị] Connection Pooling (Transaction Mode) - Port 6543 (Dành cho Next.js serverless/API routes)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection - Port 5432 (Bắt buộc dùng cho Prisma Migrations & Db Push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# 2. SUPABASE API & AUTHENTICATION
# Lấy từ: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. BACKEND NESTJS CONFIGURATION (TÙY CHỌN NẾU CHẠY MICROSERVICE)
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# 4. GOOGLE GEMINI AI CONFIGURATION (GEMINI 3.5 FLASH CHO TÍNH NĂNG GIẢI TOÁN & OCR BẰNG AI)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
